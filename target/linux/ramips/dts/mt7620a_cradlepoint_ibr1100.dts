#include "mt7620a.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "cradlepoint,ibr1100";
	model = "Cradlepoint IBR1100";

	chosen {
		bootargs-append = " ubi.mtd=Filesystem";
	};

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		label-mac-device = &ethernet;
	};

	leds {
		compatible = "gpio-leds";

		led_wlan5g: wlan5g {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
			label = "blue:wlan5g";
			linux,default-trigger = "phy0radio";
		};

		led_wlan2g: wlan2g {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
			label = "green:wlan2g";
			linux,default-trigger = "phy1radio";
		};

		led_mdm1: mdm1 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
			label = "green:int_modem";
		};

		led_mdm1_red: mdm1_red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
			label = "red:int_modem";
		};

		led_mdm2: mdm2 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
			label = "green:ext_modem";
		};

		led_mdm2_red: mdm2_red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
			label = "red:ext_modem";
		};

		led_ss_0: ss_0 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
			label = "blue:ss_0";
		};

		led_ss_1: ss_1 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
			label = "blue:ss_1";
		};

		led_ss_2: ss_2 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
			label = "blue:ss_2";
		};

		led_ss_3: ss_3 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
			label = "blue:ss_3";
		};

		led_lan_y: lan_yellow {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_YELLOW>;
			gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
			label = "yellow:lan1";
		};

		led_lan2_y: lan2_yellow {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_YELLOW>;
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
			label = "yellow:lan2";
		};

		led_wan_y: wan_yellow {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_YELLOW>;
			gpios = <&gpio2 30 GPIO_ACTIVE_LOW>;
			label = "yellow:wan";
		};

		led_power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
			label = "blue:power";
		};
	};

	gpio_export {
		compatible = "gpio-export";

		pwr_en_int1 {
			gpio-export,name = "pwr_en_int1";
			gpio-export,output = <1>;
			gpio-export,direction_may_change = <0>;
			gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		};

		pwr_en_usb {
			gpio-export,name = "pwr_en_usb";
			gpio-export,output = <1>;
			gpio-export,direction_may_change = <0>;
			gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		};

		pwr_off_latch {
			gpio-export,name = "pwr_off_latch";
			gpio-export,output = <0>;
			gpio-export,direction_may_change = <0>;
			gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		};

		pwr_off_toggle {
			gpio-export,name = "pwr_off_toggle";
			gpio-export,output = <0>;
			gpio-export,direction_may_change = <0>;
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		};

		usb_switch {
			gpio-export,name = "usb_switch";
			gpio-export,output = <0>;
			gpio-export,direction_may_change = <0>;
			gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>;
		};

		conn_ign_sense {
			gpio-export,name = "conn_ign_sense";
			gpio-export,input = <0>;
			gpio-export,direction_may_change = <0>;
			gpios = <&gpio2 26 GPIO_ACTIVE_LOW>;
		};

		conn_output {
			gpio-export,name = "conn_output";
			gpio-export,output = <0>;
			gpio-export,direction_may_change = <0>;
			gpios = <&gpio2 21 GPIO_ACTIVE_HIGH>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio2 31 GPIO_ACTIVE_LOW>;
			// linux,code = <KEY_RESTART>;
		};
	};

	nand {
		compatible = "mtk,mt7620-nand";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "Upgrade";
				reg = <0x0 0x2000000>;
			};

			partition@2000000 {
				label = "Filesystem";
				reg = <0x2000000 0xe000000>;
			};
		};
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash0: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		m25p,fast-read;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "Bootloader";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "Config";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "Factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x200>;
					};

					eeprom_factory_8000: eeprom@8000 {
						reg = <0x8000 0x200>;
					};

					macaddr_factory_28: macaddr@28 {
						reg = <0x28 0x6>;
					};
				};
			};

			partition@50000 {
				label = "Kernel";
				reg = <0x50000 0x1c0000>;
			};

			partition@210000 {
				label = "rootfs";
				reg = <0x210000 0xb60000>;
			};

			partition@d70000 {
				label = "2nd Filemanager";
				reg = <0xd70000 0x20000>;
			};

			partition@d90000 {
				label = "Filemanager";
				reg = <0xd90000 0x20000>;
			};
		};
	};
};

&ethernet {
	nvmem-cells = <&macaddr_factory_28>;
	nvmem-cell-names = "mac-address";
	mediatek,portmap = "llwll";
};

&wmac {
	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";
	pinctrl-names = "default", "pa_gpio";
	pinctrl-0 = <&pa_pins>;
	pinctrl-1 = <&pa_gpio_pins>;
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

&i2c {
	status = "okay";

	therm: temperature-sensor@4d {
		compatible = "lm90";
		reg = <0x4d>;
		#thermal-sensor-cells = <1>;
		status = "okay";
	};
};

&pcie {
	status = "okay";
};

&uart {
	/* status = "okay"; */
};

&pcie0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		ieee80211-freq-limit = <5000000 6000000>;
		nvmem-cells = <&eeprom_factory_8000>;
		nvmem-cell-names = "eeprom", "mac-address";
	};
};
