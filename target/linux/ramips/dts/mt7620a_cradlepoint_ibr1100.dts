#include "mt7620a_cradlepoint_ibr-b.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "cradlepoint,ibr1100";
	model = "Cradlepoint IBR1100";

	chosen {
		bootargs-append = " ubi.mtd=Filesystem";
	};

	leds {
		compatible = "gpio-leds";

		led_wlan5g: wlan5g {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
			label = "blue:wlan5g";
			linux,default-trigger = "phy0radio";
		};

		led_mdm2: mdm2 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
			label = "green:ext_modem";
		};

		led_mdm2_red: mdm2_red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
			label = "red:ext_modem";
		};

		led_lan2_y: lan2_yellow {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_YELLOW>;
			gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
			label = "yellow:lan2";
		};

		led_lan_y: lan_yellow {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_YELLOW>;
			gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
			label = "yellow:lan1";
		};

		led_wan_y: wan_yellow {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_YELLOW>;
			gpios = <&gpio2 30 GPIO_ACTIVE_LOW>;
			label = "yellow:wan";
		};

		led_power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
			label = "blue:power";
		};
	};

	gpio_export {
		compatible = "gpio-export";

		usb_switch {
			gpio-export,name = "usb_switch";
			gpio-export,output = <0>;
			gpio-export,direction_may_change = <0>;
			gpios = <&gpio3 0 GPIO_ACTIVE_LOW>;
		};
	};
};

&state_default {
	default {
		groups = "pa";
		function = "gpio";
	};
};

&ethernet {
	nvmem-cells = <&macaddr_factory_28>;
	nvmem-cell-names = "mac-address";
	mediatek,portmap = "llwll";
};

&pcie {
	status = "okay";
};

&uart {
	/* status = "okay"; */
};

&pcie0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		ieee80211-freq-limit = <5000000 6000000>;
		nvmem-cells = <&eeprom_factory_8000>;
		nvmem-cell-names = "eeprom", "mac-address";
	};
};

&led_ss_0 {
	gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
};

&led_ss_1 {
	gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
};

&led_ss_2 {
	gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
};

&led_ss_3 {
	gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
};

&led_wlan2g {
	gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
};

&led_mdm1 {
	gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
};

&led_mdm1_red {
	gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
};
